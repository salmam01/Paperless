{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/Logs/Paperless-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      }
    ]
  },
  "ConnectionString": "Host=paperless-db;Port=5432;Database=PaperlessDB;Username=swen3;Password=<secret>",
  "AccessData": {
    "InputFolder": "Input",
    "ArchiveFolder": "Archive",
    "SearchPattern": "accessdata_*.xml"
  },
  "Job": {
    "CronExpression": "0 0/5 * * * ?"
  }
}
